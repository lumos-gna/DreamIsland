%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 915396d3d934ae841b175b06346b2ce2, type: 3}
  m_Name: SnakeFairyData
  m_EditorClassIdentifier: 
  text: "\uB098\uB294 \uC0AC\uB9C9\uC758 \uADF8\uB9BC\uC790 \uC18D\uC5D0\uC11C \uC870\uC6A9\uD788
    \uAFC8\uC744 \uC9C0\uD0A4\uB294 \uBC40\uC694\uC815, \uB8E8\uBBF8\uC758 \uC5B4\uB460\uACFC
    \uC9D1\uCC29\uC758 \uC77C\uBD80\uC9C0."
  npcDialog:
  - type: 3
    buttonName: "\uB79C\uB364 \uD018\uC2A4\uD2B8"
    npcDialogTexts:
    - text: "\uD018\uC2A4\uD2B8"
      exitButton: 1
  - type: 0
    buttonName: "\uC7A1\uB2F4"
    npcDialogTexts:
    - text: "\uAFC8\uC740 \uC601\uC6D0\uD574. \uB10C \uC5EC\uAE30\uC11C \uC790\uC720\uB85C\uC6B8
        \uC218 \uC788\uC5B4, \uD604\uC2E4\uC758 \uACE0\uD1B5 \uC5C6\uC774."
      exitButton: 1
    - text: "\uB124\uAC00 \uB5A0\uB09C\uB2E4\uBA74, \uB098\uB3C4 \uC0AC\uB77C\uC838\uBC84\uB9B4
        \uAC70\uC57C. \uB10C \uB098\uC758 \uC874\uC7AC \uC774\uC720\uC57C."
      exitButton: 1
    - text: "\uD604\uC2E4\uC740 \uC544\uD320\uC9C0. \uC5EC\uAE34 \uADF8\uBCF4\uB2E4
        \uD6E8\uC52C \uC548\uC804\uD574. \uADF8\uAC78 \uB124\uAC00 \uBAA8\uB97C \uB9AC
        \uC5C6\uC5B4."
      exitButton: 1
    - text: "\uC774 \uC12C \uC5B4\uB518\uAC00\uC5D0 \uB8E8\uBBF8\uC758 \uC794\uD5A5\uC774
        \uB0A8\uC544 \uC788\uC5B4. \uADF8\uB140\uB294 \uC544\uC9C1 \uC644\uC804\uD788
        \uB110 \uB193\uC9C0 \uC54A\uC558\uAC70\uB4E0. \uD558\uC9C0\uB9CC\u2026 \uC5B4\uCA4C\uBA74
        \uADF8\uAC74 \uBCF4\uD638\uC77C\uC9C0\uB3C4 \uBAB0\uB77C."
      exitButton: 1
  - type: 2
    buttonName: "\uAE30\uC5B5 \uC870\uAC01"
    npcDialogTexts:
    - text: "\uAE30\uC5B5 \uC870\uAC01\uC744 \uCC3E\uACE0 \uC2F6\uB2E4\uACE0? \uADF8\uAC8C
        \uAF2D \uB108\uB97C \uC704\uD55C \uAC70\uB77C\uACE0\u2026 \uD655\uC2E0\uD560
        \uC218 \uC788\uC5B4?"
      exitButton: 0
    - text: "\uADF8 \uC870\uAC01\uB4E4\uC740 \uB124\uAC00 \uC77C\uBD80\uB7EC \uC78A\uC5B4\uBC84\uB9B0
        \uAC83\uB4E4\uC774\uC57C. \uB204\uAC00 \uBC84\uB9B0 \uAE30\uC5B5\uC744 \uB2E4\uC2DC
        \uC90D\uACE0 \uC2F6\uC5B4 \uD558\uACA0\uC5B4?"
      exitButton: 0
    - text: "\uBAA8\uC73C\uBA74 \uC544\uD504\uACE0, \uC78A\uC73C\uBA74 \uD3B8\uD574.
        \uADF8\uB7F0\uB370\uB3C4, \uAD73\uC774\u2026 \uC9C4\uC2E4\uC744 \uBCF4\uACE0
        \uC2F6\uB2E4\uACE0?"
      exitButton: 0
    - text: "\uAE30\uC5B5 \uC870\uAC01\uC744 \uBAA8\uB450 \uBAA8\uC740\uB2E4\uACE0
        \uD574\uC11C, \uC9C4\uC2E4\uC774 \uB108\uB97C \uBC18\uACA8\uC904 \uAC70\uB780
        \uBCF4\uC7A5\uC740 \uC5C6\uC5B4. \uADF8 \uC870\uAC01\uB4E4\uC740 \uB124\uAC00
        \uC560\uC368 \uBC84\uB9B0 \uAC83\uB4E4\uC774\uB2C8\uAE4C."
      exitButton: 1
  randomQuests:
  - name: "\uBC40 \uB79C\uB364 \uD018\uC2A4\uD2B8 1"
    text: "\uBC40 \uB79C\uB364 \uD018\uC2A4\uD2B8 1"
    uiText: "\uBC40 \uB79C\uB364 \uD018\uC2A4\uD2B8 1"
    clearText: "\uBC40 \uB79C\uB364 \uD018\uC2A4\uD2B8 \uD074\uB9AC\uC5B4 1"
    goal: 1
    reward: 1
  - name: "\uBC40 \uB79C\uB364 \uD018\uC2A4\uD2B8 2"
    text: "\uBC40 \uB79C\uB364 \uD018\uC2A4\uD2B8 2"
    uiText: "\uBC40 \uB79C\uB364 \uD018\uC2A4\uD2B8 2"
    clearText: "\uBC40 \uB79C\uB364 \uD018\uC2A4\uD2B8 \uD074\uB9AC\uC5B4 2"
    goal: 2
    reward: 2
  - name: "\uBC40 \uB79C\uB364 \uD018\uC2A4\uD2B8 3"
    text: "\uBC40 \uB79C\uB364 \uD018\uC2A4\uD2B8 3"
    uiText: "\uBC40 \uB79C\uB364 \uD018\uC2A4\uD2B8 3"
    clearText: "\uBC40 \uB79C\uB364 \uD018\uC2A4\uD2B8 \uD074\uB9AC\uC5B4 3"
    goal: 3
    reward: 3
  quests:
  - name: "\uBA54\uC778 \uD018\uC2A4\uD2B8"
    text: "\uBA54\uC778 \uD018\uC2A4\uD2B8 \uC2DC\uC791"
    uiText: "\uAE30\uC5B5 \uC870\uAC01\uC744 \uBAA8\uC544\uB77C"
    clearText: "\u2026\uC774\uC81C \uB108\uB294 \uBAA8\uB4E0 \uC870\uAC01\uC744 \uBAA8\uC558\uAD6C\uB098.
      \uB124\uAC00 \uB204\uAD6C\uC600\uB294\uC9C0, \uC65C \uC5EC\uAE30\uC5D0 \uAC07\uD614\uB294\uC9C0,
      \uC5B4\uB5BB\uAC8C \uB3CC\uC544\uAC08 \uC218 \uC788\uB294\uC9C0\uB3C4\u2026
      \uC774\uC81C \uBAA8\uB450 \uC54C\uAC8C \uB420 \uAC70\uC57C."
    goal: 3
    reward: 1
