%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 915396d3d934ae841b175b06346b2ce2, type: 3}
  m_Name: DesertFairyData
  m_EditorClassIdentifier: 
  text: "\uC5EC\uAE34 \uB124\uAC00 \uBAA8\uB4E0 \uAC78 \uBC84\uB9AC\uACE0 \uB3C4\uB9DD\uCE58\uACE0
    \uC2F6\uC744 \uB54C \uC0DD\uACA8\uB09C \uACF3\uC774\uC57C. \uADF8\uB9AC\uACE0\u2026
    \uB09C \uADF8\uB7F0 \uB108\uB791 \uD568\uAED8 \uC788\uB294 \uAC8C \uC88B\uC544.
    \uADF8\uB7EC\uB2C8\uAE4C\u2026 \uADF8\uB0E5 \uC5EC\uAE30 \uC788\uC790. \uC6B0\uB9AC
    \uB458\uC774."
  npcDialog:
  - type: 3
    buttonName: "\uB79C\uB364 \uD018\uC2A4\uD2B8"
    npcDialogTexts:
    - text: "\uD018\uC2A4\uD2B8"
      exitButton: 1
  - type: 0
    buttonName: "\uC7A1\uB2F4"
    npcDialogTexts:
    - text: "\uC774\uC81C \uB3CC\uC774\uD0AC \uC218 \uC5C6\uC5B4. \uB124\uAC00 \uC774\uB807\uAC8C
        \uAE4A\uC740 \uACF3\uAE4C\uC9C0 \uC628 \uAC74\u2026 \uC9C4\uC9DC \uB124 \uB9C8\uC74C\uC778
        \uAC70\uC796\uC544."
      exitButton: 1
    - text: "\uD604\uC2E4\uC5D0 \uB3CC\uC544\uAC00\uBA74, \uB2E4\uC2DC \uC0C1\uCC98\uBC1B\uACE0\u2026
        \uB2E4\uC2DC \uC678\uB85C\uC6CC\uC9C0\uACE0\u2026 \uB2E4\uC2DC \uBC84\uB824\uC9C8
        \uD150\uB370. \uC5EC\uAE30\uC11C\uB294\u2026 \uADF8\uB0E5 \uB098\uB791 \uC788\uC790,
        \uC544\uB9B0."
      exitButton: 1
  - type: 2
    buttonName: "\uB2E4\uC74C \uC9C0\uC5ED?"
    npcDialogTexts:
    - text: "\uB2E4\uC74C \uC9C0\uC5ED\uC740 \uB354 \uC774\uC0C1 \uC5C6\uC5B4. \uC774\uC820\u2026
        \uC120\uD0DD\uC744 \uD574\uC57C\uD574"
      exitButton: 0
    - text: "\uC544\uD508 \uD604\uC2E4\uB85C \uB3CC\uC544\uAC08\uC9C0, \uC544\uB2C8\uBA74
        \uC5EC\uAE30\uC11C \uACC4\uC18D \uC0B4\uC544\uAC08\uC9C0."
      exitButton: 0
    - text: "\uC5EC\uAE30\uC5D0\uC120 \uACE8\uB818\uACFC \uD574\uACE8\uC774 \uB098\uC62C\uAC70\uC57C,
        \uADF8\uAC83\uB4E4\uC5D0\uAC8C\uC11C \uCD1B\uBD88\uC744 \uCC3E\uC544 \uC81C\uB2E8\uC744
        \uAEA0\uC6CC\uC57C \uD574.  \uD558\uC9C0\uB9CC \uC870\uC2EC\uD574. \uC0AC\uB9C9\uC758
        \uB354\uC704\uAC00 \uB110 \uC704\uD611\uD560\uAEBC\uC57C."
      exitButton: 1
  randomQuests:
  - name: Golem
    text: "\uD639\uC2DC \uACE8\uB818\uC744 \uBCF8\uC801 \uC788\uB2C8?! \uC644\uC804
      \uAC70\uB300\uD574\u2026! \uB3CC\uB85C \uB9CC\uB4E0 \uBAB8\uC5D0, \uC544\uBB34
      \uD45C\uC815\uB3C4 \uC5C6\uC5B4. \uC544\uB9C8\uB3C4 \uACE8\uB818\uC740 \uB110
      \uBC29\uD574\uD560\uAEBC\uC57C... \uC870\uC2EC\uD574\uC57C\uD574!"
    uiText: "\uACE8\uB818\uC744 \uC4F0\uB7EC\uD2B8\uB9AC\uC790"
    clearText: "\uD559 \uB79C\uB364 \uD018\uC2A4\uD2B8 2 \uD074\uB9AC\uC5B4"
    goal: 5
    reward: 2
  - name: Skullsln
    text: "\uC774\uACF3\uC758 \uD574\uACE8\uC740 \uD2B9\uC774\uD55C \uBAA8\uC790\uB97C
      \uC4F0\uACE0\uC788\uC5B4. \uADF8\uB9AC\uACE0 \uCD1D\uC73C\uB85C \uB110 \uACF5\uACA9\uD560\uAC70\uC57C.
      \uC870\uC2EC\uD574! "
    uiText: "\uD574\uACE8\uC744 \uC4F0\uB7EC\uD2B8\uB9AC\uC790"
    clearText: "\uBAA8\uC790\uB294 \uC5B4\uB54C? \uB9D8\uC5D0\uB4E4\uC5B4?"
    goal: 5
    reward: 2
  mainQuests:
    name: "\uBA54\uC778 \uD018\uC2A4\uD2B83"
    text: 
    uiText: "\uCD1B\uBD88\uC744 \uCC3E\uC790"
    clearText: 
    goal: 3
    reward: 1
