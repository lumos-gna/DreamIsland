%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 915396d3d934ae841b175b06346b2ce2, type: 3}
  m_Name: DesertFairyData
  m_EditorClassIdentifier: 
  text: "\uC5EC\uAE34 \uB124\uAC00 \uBAA8\uB4E0 \uAC78 \uBC84\uB9AC\uACE0 \uB3C4\uB9DD\uCE58\uACE0
    \uC2F6\uC744 \uB54C \uC0DD\uACA8\uB09C \uACF3\uC774\uC57C. \uADF8\uB9AC\uACE0\u2026
    \uB09C \uADF8\uB7F0 \uB108\uB791 \uD568\uAED8 \uC788\uB294 \uAC8C \uC88B\uC544.
    \uADF8\uB7EC\uB2C8\uAE4C\u2026 \uADF8\uB0E5 \uC5EC\uAE30 \uC788\uC790. \uC6B0\uB9AC
    \uB458\uC774."
  npcDialog:
  - type: 3
    buttonName: "\uB79C\uB364 \uD018\uC2A4\uD2B8"
    npcDialogTexts:
    - text: "\uD018\uC2A4\uD2B8"
      exitButton: 1
  - type: 0
    buttonName: "\uC7A1\uB2F4"
    npcDialogTexts:
    - text: "\uC774\uC81C \uB3CC\uC774\uD0AC \uC218 \uC5C6\uC5B4. \uB124\uAC00 \uC774\uB807\uAC8C
        \uAE4A\uC740 \uACF3\uAE4C\uC9C0 \uC628 \uAC74\u2026 \uC9C4\uC9DC \uB124 \uB9C8\uC74C\uC778
        \uAC70\uC796\uC544."
      exitButton: 1
    - text: "\uD604\uC2E4\uC5D0 \uB3CC\uC544\uAC00\uBA74, \uB2E4\uC2DC \uC0C1\uCC98\uBC1B\uACE0\u2026
        \uB2E4\uC2DC \uC678\uB85C\uC6CC\uC9C0\uACE0\u2026 \uB2E4\uC2DC \uBC84\uB824\uC9C8
        \uD150\uB370. \uC5EC\uAE30\uC11C\uB294\u2026 \uADF8\uB0E5 \uB098\uB791 \uC788\uC790,
        \uC544\uB9B0."
      exitButton: 1
  - type: 1
    buttonName: "\uAE30\uC5B5 \uC870\uAC01"
    npcDialogTexts:
    - text: "\uB4F1\uBD88\uC740 \uB354 \uC774\uC0C1 \uC5C6\uB300. \uC774\uC820\u2026
        \uBE5B\uC73C\uB85C\uB294 \uAE38\uC744 \uC5F4 \uC218 \uC5C6\uC5B4."
      exitButton: 0
    - text: "\uC5EC\uAE30\uC120\u2026 \uB124 \uAE30\uC5B5 \uC870\uAC01\uC774 \uBB38\uC744
        \uC7A0\uAC00\uB193\uC558\uC5B4. \uC78A\uACE0 \uC2F6\uC5C8\uB358 \uAC83\uB4E4,
        \uAC10\uCDC4\uB358 \uAC10\uC815\uB4E4, \uADF8\uB7F0 \uAC8C \uC774 \uC0AC\uB9C9
        \uC5B4\uB518\uAC00\uC5D0 \uD769\uC5B4\uC838 \uC788\uC5B4."
      exitButton: 0
    - text: "\uB2E4 \uCC3E\uC73C\uBA74 \uBB38\uC774 \uC5F4\uB9B4 \uAC70\uC57C. \uD558\uC9C0\uB9CC
        \uC870\uC2EC\uD574. \uCC3E\uB294\uB2E4\uACE0 \uB2E4 \uC88B\uC740 \uAC74 \uC544\uB2C8\uAC70\uB4E0."
      exitButton: 1
  randomQuests:
  - name: "\uBC40 \uB79C\uB364 \uD018\uC2A4\uD2B8 1"
    text: "\uBC40 \uB79C\uB364 \uD018\uC2A4\uD2B8 1"
    uiText: "\uBC40 \uB79C\uB364 \uD018\uC2A4\uD2B8 1"
    clearText: "\uBC40 \uB79C\uB364 \uD018\uC2A4\uD2B8 \uD074\uB9AC\uC5B4 1"
    goal: 1
    reward: 1
  - name: "\uBC40 \uB79C\uB364 \uD018\uC2A4\uD2B8 2"
    text: "\uBC40 \uB79C\uB364 \uD018\uC2A4\uD2B8 2"
    uiText: "\uBC40 \uB79C\uB364 \uD018\uC2A4\uD2B8 2"
    clearText: "\uBC40 \uB79C\uB364 \uD018\uC2A4\uD2B8 \uD074\uB9AC\uC5B4 2"
    goal: 2
    reward: 2
  - name: "\uBC40 \uB79C\uB364 \uD018\uC2A4\uD2B8 3"
    text: "\uBC40 \uB79C\uB364 \uD018\uC2A4\uD2B8 3"
    uiText: "\uBC40 \uB79C\uB364 \uD018\uC2A4\uD2B8 3"
    clearText: "\uBC40 \uB79C\uB364 \uD018\uC2A4\uD2B8 \uD074\uB9AC\uC5B4 3"
    goal: 3
    reward: 3
  quests:
  - name: "\uBA54\uC778 \uD018\uC2A4\uD2B8"
    text: "\uBA54\uC778 \uD018\uC2A4\uD2B8 \uC2DC\uC791"
    uiText: "\uAE30\uC5B5 \uC870\uAC01\uC744 \uBAA8\uC544\uB77C"
    clearText: "\u2026\uC774\uC81C \uB108\uB294 \uBAA8\uB4E0 \uC870\uAC01\uC744 \uBAA8\uC558\uAD6C\uB098.
      \uB124\uAC00 \uB204\uAD6C\uC600\uB294\uC9C0, \uC65C \uC5EC\uAE30\uC5D0 \uAC07\uD614\uB294\uC9C0,
      \uC5B4\uB5BB\uAC8C \uB3CC\uC544\uAC08 \uC218 \uC788\uB294\uC9C0\uB3C4\u2026
      \uC774\uC81C \uBAA8\uB450 \uC54C\uAC8C \uB420 \uAC70\uC57C."
    goal: 3
    reward: 1
