%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 915396d3d934ae841b175b06346b2ce2, type: 3}
  m_Name: ForestFairyData
  m_EditorClassIdentifier: 
  text: "\uC774 \uC232\uC740 \uB110 \uAE30\uC5B5\uD558\uACE0 \uC788\uC5B4. \uB098\uBB34\uB3C4,
    \uBC14\uB78C\uB3C4, \uB2E4 \uB124 \uD3B8\uC774\uC57C. \uC870\uAE08\uB9CC \uB354
    \uCC9C\uCC9C\uD788 \uAC00\uB3C4 \uB3FC. \uC11C\uB450\uB97C \uD544\uC694 \uC5C6\uC796\uC544?
    \uC5EC\uAE34 \uAFC8\uC774\uB2C8\uAE4C"
  npcDialog:
  - type: 3
    buttonName: "\uB79C\uB364 \uD018\uC2A4\uD2B8"
    npcDialogTexts:
    - text: "\uD018\uC2A4\uD2B8"
      exitButton: 1
  - type: 0
    buttonName: "\uB300\uD654\uD55C\uB2E4"
    npcDialogTexts:
    - text: "\uC5EC\uAE34 \uB9C8\uC74C\uC774 \uC26C\uB294 \uACF3\uC774\uC57C. \uC544\uBB34
        \uAC71\uC815\uB3C4, \uC544\uD514\uB3C4 \uC5C6\uC9C0? \uACC4\uC18D \uBA38\uBB34\uB974\uACE0
        \uC2F6\uC9C0 \uC54A\uC544?"
      exitButton: 1
    - text: "\uD604\uC2E4\uC5D0\uC11C\uB294 \uC774\uB7F0 \uB098\uBB34 \uC5C6\uC9C0?
        \uC774\uAC74 \uB108\uC758 \uC0C1\uC0C1\uC774 \uB9CC\uB4E0 \uC138\uACC4\uB2C8\uAE4C\u2026
        \uC6D0\uD558\uB294 \uB300\uB85C \uC790\uB77C\uAC8C \uD560 \uC218 \uC788\uC5B4."
      exitButton: 1
  - type: 2
    buttonName: "\uB208 \uC9C0\uC5ED?"
    npcDialogTexts:
    - text: "\uC774 \uC232\uC740 \uB124 \uB9C8\uC74C\uC758 \uC548\uC2DD\uCC98\uC600\uC9C0\uB9CC,
        \uC9C0\uAE08\uC740 \uAE38\uC774 \uB2EB\uD614\uC5B4. \uCD94\uC5B5 \uC18D \uC5B4\uB518\uAC00\uC5D0
        \uC228\uACA8\uC9C4 \uCD1B\uBD88\uC744 \uAE68\uC6B0\uBA74, \uB208\uC758 \uBB38\uC774
        \uC5F4\uB9B4 \uAC70\uC57C."
      exitButton: 0
    - text: "\uBC24\uC774 \uB418\uBA74 \uBC84\uC12F \uAD34\uBB3C\uC774 \uBCFC \uC218
        \uC788. \uADF8\uAC83\uB4E4\uC774 \uCD1B\uBD88\uC744 \uAC00\uC838\uC788\uC744\uAC70\uC57C."
      exitButton: 0
    - text: "\uADF8 \uCD1B\uBD88\uC744 \uC81C\uB2E8\uC5D0 \uAC00\uC838\uAC00\uC57C
        \uD574. \uC544\uB9C8 \uC81C\uB2E8\uC758 \uC704\uCE58\uB294\uC740 \uCD1B\uBD88\uC774
        \uC54C\uB824\uC904\uAC70\uC57C..."
      exitButton: 1
  - type: 1
    buttonName: "\uAC74\uCD95?"
    npcDialogTexts:
    - text: "\uAC74\uCD95\uC5D0 \uB300\uD55C \uC124\uBA85"
      exitButton: 1
  randomQuests:
  - name: Deer
    text: "\uBC30\uACE0\uD504\uAD6C\uB098? \uC0AC\uC2B4\uC744 \uC7A1\uC73C\uBA74
      \uACE0\uAE30\uB97C \uBA39\uC744\uC218 \uC788\uC744\uAEBC\uC57C. \uD558\uC9C0\uB9CC
      \uAC00\uAE4C\uC774 \uB2E4\uAC00\uAC00\uB824 \uD558\uBA74 \uB3C4\uB9DD\uCCD0
      \uBC84\uB9B4\uD14C\uB2C8, \uB108\uBB34 \uAC00\uAE4C\uC774 \uB2E4\uAC00\uAC00\uC9C0
      \uB9C8!"
    uiText: "\uC0AC\uC2B4\uC744 \uC7A1\uC544\uBCF4\uC790"
    clearText: "\uC0AC\uC2B4 \uACE0\uAE30\uB97C \uBA39\uC73C\uBA74 \uAE30\uC6B4\uC774
      \uC880 \uB0A0\uAC70\uC57C!"
    goal: 3
    reward: 1
  - name: Mushroom
    text: "\uC774 \uC138\uACC4\uC758 \uBC24\uC5D0\uB294 \uAD34\uBB3C\uB4E4\uC774
      \uB098\uD0C0\uB098. \uC774\uACF3 \uC232\uC5D0\uC120 \uBC84\uC12F\uAD34\uBB3C\uC774
      \uB110 \uACF5\uACA9\uD560\uAEBC\uC57C... \uBA87\uB9C8\uB9AC\uB9CC \uC7A1\uC544\uBCF4\uC790."
    uiText: "\uBC84\uC12F \uAD34\uBB3C\uC744 \uC4F0\uB7EC\uD2B8\uB9AC\uC790"
    clearText: "\uC798\uD588\uC5B4! \uC544\uB9C8 \uC774\uB7F0\uC2DD\uC73C\uB85C \uBC24\uB9C8\uB2E4
      \uAD34\uBB3C\uB4E4\uC774 \uB110 \uACF5\uACA9\uD560\uAC70\uC57C. "
    goal: 5
    reward: 2
  mainQuests:
    name: "\uBA54\uC778 \uD018\uC2A4\uD2B81"
    text: 
    uiText: "\uB2E4\uC74C \uC9C0\uC5ED\uC73C\uB85C \uAC00\uC790"
    clearText: 
    goal: 1
    reward: 1
