%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 915396d3d934ae841b175b06346b2ce2, type: 3}
  m_Name: ForestFairyData
  m_EditorClassIdentifier: 
  text: "\uC774 \uC232\uC740 \uB110 \uAE30\uC5B5\uD558\uACE0 \uC788\uC5B4. \uB098\uBB34\uB3C4,
    \uBC14\uB78C\uB3C4, \uB2E4 \uB124 \uD3B8\uC774\uC57C. \uC870\uAE08\uB9CC \uB354
    \uCC9C\uCC9C\uD788 \uAC00\uB3C4 \uB3FC. \uC11C\uB450\uB97C \uD544\uC694 \uC5C6\uC796\uC544?
    \uC5EC\uAE34 \uAFC8\uC774\uB2C8\uAE4C"
  npcDialog:
  - type: 3
    buttonName: "\uB79C\uB364 \uD018\uC2A4\uD2B8"
    npcDialogTexts:
    - text: "\uD018\uC2A4\uD2B8"
      exitButton: 1
  - type: 0
    buttonName: "\uB300\uD654\uD55C\uB2E4"
    npcDialogTexts:
    - text: "\uC5EC\uAE34 \uB9C8\uC74C\uC774 \uC26C\uB294 \uACF3\uC774\uC57C. \uC544\uBB34
        \uAC71\uC815\uB3C4, \uC544\uD514\uB3C4 \uC5C6\uC9C0? \uACC4\uC18D \uBA38\uBB34\uB974\uACE0
        \uC2F6\uC9C0 \uC54A\uC544?"
      exitButton: 1
    - text: "\uD604\uC2E4\uC5D0\uC11C\uB294 \uC774\uB7F0 \uB098\uBB34 \uC5C6\uC9C0?
        \uC774\uAC74 \uB108\uC758 \uC0C1\uC0C1\uC774 \uB9CC\uB4E0 \uC138\uACC4\uB2C8\uAE4C\u2026
        \uC6D0\uD558\uB294 \uB300\uB85C \uC790\uB77C\uAC8C \uD560 \uC218 \uC788\uC5B4."
      exitButton: 1
  - type: 1
    buttonName: "\uAD34\uBB3C?"
    npcDialogTexts:
    - text: "\uBC84\uC12F \uAD34\uBB3C\uC740 \uAC00\uAE4C\uC774 \uC624\uBA74 \uB3C5\uC131
        \uD3EC\uC790\uB97C \uBFCC\uB824\uC11C \uC6B0\uB9AC\uB97C \uC57D\uD558\uAC8C
        \uB9CC\uB4E4\uC5B4."
      exitButton: 0
    - text: "\uC800 \uBC15\uC950\uB4E4\uC740 \uCD08\uC74C\uD30C\uB85C \uAD34\uB86D\uAC8C
        \uB9CC\uB4E4\uC5B4."
      exitButton: 0
    - text: "\uACE8\uB818\uC740 \uB2E8\uB2E8\uD574\uC11C \uC9C1\uC811 \uC2F8\uC6B0\uAE30
        \uD798\uB4E4\uC9C0\uB9CC, \uB3CC\uC744 \uBA40\uB9AC \uB358\uC838\uC11C \uACF5\uACA9\uD574."
      exitButton: 1
  - type: 2
    buttonName: "\uB208 \uC9C0\uC5ED?"
    npcDialogTexts:
    - text: "\uC774 \uC232\uC740 \uB124 \uB9C8\uC74C\uC758 \uC548\uC2DD\uCC98\uC600\uC9C0\uB9CC,
        \uC9C0\uAE08\uC740 \uAE38\uC774 \uB2EB\uD614\uC5B4. \uCD94\uC5B5 \uC18D \uC5B4\uB518\uAC00\uC5D0
        \uC228\uACA8\uC9C4 \uB4F1\uBD88\uC744 \uAE68\uC6B0\uBA74, \uB208\uC758 \uBB38\uC774
        \uC5F4\uB9B4 \uAC70\uC57C."
      exitButton: 0
    - text: "\uC870\uC2EC\uC2A4\uB808 \uCC3E\uC544\uBD10. \uC774\uAC74 \uADF8\uB0E5
        \uBE5B\uC774 \uC544\uB2C8\uB77C, \uB124\uAC00 \uC9C0\uB098\uC628 \uC2DC\uAC04\uC758
        \uBD88\uC528\uAC70\uB4E0."
      exitButton: 1
  randomQuests:
  - name: "\uD559 \uB79C\uB364 \uD018\uC2A4\uD2B8 1"
    text: "\uD559 \uB79C\uB364 \uD018\uC2A4\uD2B8 1"
    uiText: "\uD559 \uB79C\uB364 \uD018\uC2A4\uD2B8 1"
    clearText: "\uD559 \uB79C\uB364 \uD018\uC2A4\uD2B8 \uD074\uB9AC\uC5B41"
    goal: 1
    reward: 1
  - name: "\uD559 \uB79C\uB364 \uD018\uC2A4\uD2B8 2"
    text: "\uD559 \uB79C\uB364 \uD018\uC2A4\uD2B8 2"
    uiText: "\uD559 \uB79C\uB364 \uD018\uC2A4\uD2B8 2"
    clearText: "\uD559 \uB79C\uB364 \uD018\uC2A4\uD2B8 2 \uD074\uB9AC\uC5B4"
    goal: 2
    reward: 2
  - name: "\uD559 \uB79C\uB364 \uD018\uC2A4\uD2B8 3"
    text: "\uD559 \uB79C\uB364 \uD018\uC2A4\uD2B8 3"
    uiText: "\uD559 \uB79C\uB364 \uD018\uC2A4\uD2B8 3"
    clearText: "\uD559 \uB79C\uB364 \uD018\uC2A4\uD2B8 3 \uD074\uB9AC\uC5B4"
    goal: 3
    reward: 3
  quests:
  - name: "\uBA54\uC778 \uD018\uC2A4\uD2B8"
    text: "\uBA54\uC778 \uD018\uC2A4\uD2B8 \uC2DC\uC791"
    uiText: "\uAE30\uC5B5 \uC870\uAC01\uC744 \uBAA8\uC544\uB77C"
    clearText: "\u2026\uC774\uC81C \uB108\uB294 \uBAA8\uB4E0 \uC870\uAC01\uC744 \uBAA8\uC558\uAD6C\uB098.
      \uB124\uAC00 \uB204\uAD6C\uC600\uB294\uC9C0, \uC65C \uC5EC\uAE30\uC5D0 \uAC07\uD614\uB294\uC9C0,
      \uC5B4\uB5BB\uAC8C \uB3CC\uC544\uAC08 \uC218 \uC788\uB294\uC9C0\uB3C4\u2026
      \uC774\uC81C \uBAA8\uB450 \uC54C\uAC8C \uB420 \uAC70\uC57C."
    goal: 3
    reward: 1
