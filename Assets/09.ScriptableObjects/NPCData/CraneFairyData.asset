%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 915396d3d934ae841b175b06346b2ce2, type: 3}
  m_Name: CraneFairyData
  m_EditorClassIdentifier: 
  text: "\uB098\uB294 \uAFC8\uC758 \uC232\uC5D0\uC11C \uBC14\uB78C\uCC98\uB7FC \uB0A0\uC544\uB2E4\uB2C8\uB294
    \uD559\uC694\uC815, \uB8E8\uBBF8\uC758 \uC774\uC131 \uC870\uAC01\uC774\uC57C.
    \uB108\uB97C \uC9C0\uD0A4\uACE0 \uC2F6\uC5B4\uC11C \uC5EC\uAE30 \uC788\uC5B4."
  npcDialog:
  - type: 3
    buttonName: "\uB79C\uB364 \uD018\uC2A4\uD2B8"
    npcDialogTexts:
    - text: "\uD018\uC2A4\uD2B8"
      exitButton: 1
  - type: 0
    buttonName: "\uB300\uD654\uD55C\uB2E4"
    npcDialogTexts:
    - text: "\uC5EC\uAE30\uC120 \uB108\uB97C \uC9C0\uD0AC \uC218 \uC788\uC5B4, \uD604\uC2E4\uBCF4\uB2E4
        \uC548\uC804\uD558\uAC8C. \uB124\uAC00 \uB3CC\uC544\uAC00\uBA74 \uC774 \uAFC8\uB3C4\u2026
        \uC0AC\uB77C\uC838\uBC84\uB9B4 \uAC70\uC57C."
      exitButton: 1
    - text: "\uB09C \uB124 \uACC1\uC5D0 \uC788\uACE0 \uC2F6\uC5B4. \uC774 \uC138\uACC4\uC5D0
        \uB0A8\uC544 \uD568\uAED8\uD558\uB294 \uAC8C \uCD5C\uC120\uC77C\uC9C0\uB3C4
        \uBAB0\uB77C."
      exitButton: 1
  - type: 1
    buttonName: "\uAD34\uBB3C?"
    npcDialogTexts:
    - text: "\uBC84\uC12F \uAD34\uBB3C\uC740 \uAC00\uAE4C\uC774 \uC624\uBA74 \uB3C5\uC131
        \uD3EC\uC790\uB97C \uBFCC\uB824\uC11C \uC6B0\uB9AC\uB97C \uC57D\uD558\uAC8C
        \uB9CC\uB4E4\uC5B4."
      exitButton: 0
    - text: "\uC800 \uBC15\uC950\uB4E4\uC740 \uCD08\uC74C\uD30C\uB85C \uAD34\uB86D\uAC8C
        \uB9CC\uB4E4\uC5B4."
      exitButton: 0
    - text: "\uACE8\uB818\uC740 \uB2E8\uB2E8\uD574\uC11C \uC9C1\uC811 \uC2F8\uC6B0\uAE30
        \uD798\uB4E4\uC9C0\uB9CC, \uB3CC\uC744 \uBA40\uB9AC \uB358\uC838\uC11C \uACF5\uACA9\uD574."
      exitButton: 1
  - type: 2
    buttonName: "\uC5EC\uAE30\uAC00 \uC5B4\uB514\uC57C?"
    npcDialogTexts:
    - text: "\uC5EC\uAE34 \uB108\uC758 \uB9C8\uC74C\uACFC \uAFC8\uC774 \uC5BD\uD600
        \uB9CC\uB4E4\uC5B4\uC9C4 \uACF5\uAC04, \u2018\uAFC8\uC758 \uC12C\u2019\uC774\uC57C.
        \uD604\uC2E4\uB3C4 \uC0C1\uC0C1\uB3C4 \uC544\uB2CC, \uB108\uB9CC\uC758 \uAE4A\uC740
        \uBB34\uC758\uC2DD \uC18D\u2026 \uAC00\uC7A5 \uC9C4\uC2E4\uD55C \uC138\uACC4\uC9C0."
      exitButton: 0
    - text: "\uC774\uACF3\uC5D0\uC11C\uB294 \uC2DC\uAC04\uB3C4 \uBC95\uCE59\uB3C4
        \uB108\uB97C \uB530\uB77C \uC6C0\uC9C1\uC5EC. \uD558\uC9C0\uB9CC \uC9C0\uAE08\uC740
        \uADE0\uD615\uC774 \uBB34\uB108\uC84C\uC5B4. \uBC24\uC774 \uB418\uBA74 \uC545\uBABD\uC774
        \uBC00\uB824\uC624\uACE0, \uB108\uC758 \uAE30\uC5B5\uB9C8\uC800 \uD750\uB824\uC9C0\uACE0
        \uC788\uC5B4."
      exitButton: 0
    - text: "\uB108\uB294 \uC774 \uAFC8\uC5D0\uC11C \uC0B4\uC544\uB0A8\uC544\uC57C
        \uD574. \uBC24\uC744 \uACAC\uB514\uACE0, \uB0AE\uC5D0\uB294 \uC783\uC5B4\uBC84\uB9B0
        \uAE30\uC5B5 \uC870\uAC01\uC744 \uCC3E\uC544. \uADF8 \uC870\uAC01\uB4E4\uC774
        \uBAA8\uC774\uBA74\u2026 \uB124\uAC00 \uC65C \uC5EC\uAE30 \uAC07\uD788\uAC8C
        \uB418\uC5C8\uB294\uC9C0, \uC5B4\uB5BB\uAC8C \uB3CC\uC544\uAC08 \uC218 \uC788\uB294\uC9C0\uB97C
        \uC54C\uAC8C \uB420 \uAC70\uC57C."
      exitButton: 0
    - text: "\uADF8\uB9AC\uACE0\u2026 \uB8E8\uBBF8. \uB108\uC758 \uC624\uB798\uB41C
        \uC0C1\uC0C1 \uCE5C\uAD6C\uC774\uC790, \uC774 \uC138\uACC4\uC758 \uC124\uACC4\uC790.
        \uADF8\uB140\uB294 \uB108\uB97C \uC9C0\uD0A4\uB824 \uD588\uC9C0\uB9CC, \uC5B8\uC820\uAC00\uBD80\uD130
        \uB108\uB97C \uBD99\uC7A1\uACE0 \uB193\uC9C0 \uC54A\uAC8C \uB418\uC5C8\uC5B4."
      exitButton: 0
    - text: "\uC9C0\uAE08\uC758 \uB8E8\uBBF8\uB294 \uB354 \uC774\uC0C1 \uC608\uC804\uC758
        \uB8E8\uBBF8\uAC00 \uC544\uB2C8\uC57C. \uADF8\uB140\uB294 \uB108 \uC5C6\uC774
        \uC874\uC7AC\uD560 \uC218 \uC5C6\uC5B4\uC84C\uACE0\u2026 \uADF8\uB798\uC11C
        \uB110 \uC774\uACF3\uC5D0 \uAC00\uB454 \uAC70\uC57C."
      exitButton: 0
    - text: "\uB098\uB294 \uD559\uC694\uC815. \uC774 \uC232\uC5D0\uC11C \uB108\uB97C
        \uB3C4\uC6B8 \uC218 \uC788\uB294 \uC874\uC7AC\uC57C. \uD558\uC9C0\uB9CC \uACB0\uC815\uC740
        \uC5B8\uC81C\uB098\u2026 \uB124 \uBAAB\uC774\uC57C."
      exitButton: 1
  randomQuests:
  - name: "\uD559 \uB79C\uB364 \uD018\uC2A4\uD2B8 1"
    text: "\uD559 \uB79C\uB364 \uD018\uC2A4\uD2B8 1"
    uiText: "\uD559 \uB79C\uB364 \uD018\uC2A4\uD2B8 1"
    clearText: "\uD559 \uB79C\uB364 \uD018\uC2A4\uD2B8 \uD074\uB9AC\uC5B41"
    goal: 1
    reward: 1
  - name: "\uD559 \uB79C\uB364 \uD018\uC2A4\uD2B8 2"
    text: "\uD559 \uB79C\uB364 \uD018\uC2A4\uD2B8 2"
    uiText: "\uD559 \uB79C\uB364 \uD018\uC2A4\uD2B8 2"
    clearText: "\uD559 \uB79C\uB364 \uD018\uC2A4\uD2B8 2 \uD074\uB9AC\uC5B4"
    goal: 2
    reward: 2
  - name: "\uD559 \uB79C\uB364 \uD018\uC2A4\uD2B8 3"
    text: "\uD559 \uB79C\uB364 \uD018\uC2A4\uD2B8 3"
    uiText: "\uD559 \uB79C\uB364 \uD018\uC2A4\uD2B8 3"
    clearText: "\uD559 \uB79C\uB364 \uD018\uC2A4\uD2B8 3 \uD074\uB9AC\uC5B4"
    goal: 3
    reward: 3
  quests:
  - name: "\uBA54\uC778 \uD018\uC2A4\uD2B8"
    text: "\uD559 \uD018\uC2A4\uD2B8 \uC2DC\uC791 111111"
    uiText: "\uAE30\uC5B5 \uC870\uAC01\uC744 \uBAA8\uC544\uB77C"
    clearText: "\uD559 \uD018\uC2A4\uD2B8 \uD074\uB9AC\uC5B4 11111"
    goal: 3
    reward: 1
