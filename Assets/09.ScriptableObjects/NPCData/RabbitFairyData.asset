%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 915396d3d934ae841b175b06346b2ce2, type: 3}
  m_Name: RabbitFairyData
  m_EditorClassIdentifier: 
  text: "\uB098\uB294 \uB208\uBC2D\uC744 \uB2EC\uB9AC\uB294 \uD1A0\uB07C\uC694\uC815.
    \uB8E8\uBBF8\uC758 \uB9D1\uC740 \uB9C8\uC74C\uACFC\u2026 \uB124\uAC00 \uC78A\uACE0
    \uC9C0\uB0B8 \uC6C3\uC74C\uC774 \uBAA8\uC5EC \uB9CC\uB4E4\uC5B4\uC9C4 \uC874\uC7AC\uC57C.
    \uCDA5\uC9C0? \uAD1C\uCC2E\uC544. \uB0B4\uAC00 \uC606\uC5D0 \uC788\uC744\uAC8C.
    \uC774\uACF3\uC5D0\uC120 \uC544\uBB34\uB3C4 \uB108\uB97C \uC544\uD504\uAC8C \uD558\uC9C0
    \uC54A\uC544."
  npcDialog:
  - type: 3
    buttonName: "\uB79C\uB364 \uD018\uC2A4\uD2B8"
    npcDialogTexts:
    - text: "\uD018\uC2A4\uD2B8"
      exitButton: 1
  - type: 0
    buttonName: "\uB300\uD654\uD55C\uB2E4"
    npcDialogTexts:
    - text: "\uC544\uB9B0, \uC6B0\uB9AC\uB791 \uAC19\uC774 \uC788\uC5B4\uC918. \uC5EC\uAE30\uC120
        \uC544\uD504\uC9C0 \uC54A\uC544, \uC678\uB86D\uC9C0\uB3C4 \uC54A\uC544."
      exitButton: 1
    - text: "\uBC16\uC740 \uB108\uBB34 \uD798\uB4E4\uC796\uC544\u2026 \uB098\uB791
        \uB208\uBC2D\uC5D0\uC11C \uB610 \uB180\uC790, \uC57D\uC18D\uD560\uAC8C."
      exitButton: 1
  - type: 2
    buttonName: "\uAE30\uC5B5\uC870\uAC01"
    npcDialogTexts:
    - text: "\uAE30\uC5B5 \uC870\uAC01\u2026? \uC751, \uC5EC\uAE30\uC800\uAE30 \uD769\uC5B4\uC838
        \uC788\uC5B4. \uC544\uC8FC \uC624\uB798\uC804\uC5D0 \uB108\uD55C\uD14C\uC11C
        \uB5A8\uC5B4\uC838 \uB098\uC628 \uAC83\uB4E4\uC774\uC57C."
      exitButton: 0
    - text: "\uD558\uC9C0\uB9CC \uAF2D \uB2E4 \uBAA8\uC544\uC57C \uD574\u2026? \uB2E4
        \uCC3E\uC73C\uBA74, \uB108\u2026 \uC0AC\uB77C\uC9C0\uB294 \uAC70 \uC544\uB2C8\uC57C?"
      exitButton: 0
    - text: "\uADF8 \uAE30\uC5B5\uB4E4, \uAF2D \uB2E4\uC2DC \uB5A0\uC62C\uB824\uC57C
        \uD558\uB294 \uAC78\uAE4C? \uD798\uB4E4\uC5C8\uB358 \uC77C\uB3C4 \uB9CE\uC558\uC796\uC544.
        \uC9C0\uAE08\uC740\u2026 \uC6C3\uACE0 \uC788\uC744 \uC218 \uC788\uB294\uB370."
      exitButton: 1
  - type: 1
    buttonName: "\uAC74\uCD95?"
    npcDialogTexts:
    - text: "\uC544\uB9B0, \uC5EC\uAE30\uC120 \uB124\uAC00 \uC6D0\uD558\uB294 \uB300\uB85C
        \uC9D1\uC744 \uB9CC\uB4E4 \uC218 \uC788\uC5B4! \uB208\uBC2D\uC5D0 \uB530\uB73B\uD55C
        \uC6B8\uD0C0\uB9AC\uB3C4 \uC138\uC6B0\uACE0, \uBD88\uBE5B\uB3C4 \uBC1D\uD600\uC11C
        \uBB34\uC11C\uC6B4 \uBC24\uC744 \uC774\uACA8\uB0B4\uC790."
      exitButton: 0
    - text: "\uB098\uBB34\uB791 \uB3CC, \uBC18\uC9DD\uC774\uB294 \uC5BC\uC74C \uC870\uAC01\uB3C4
        \uC4F8 \uC218 \uC788\uC5B4. \uB108\uB9CC\uC758 \uC548\uC804\uD55C \uBCF4\uAE08\uC790\uB9AC\uB97C
        \uAFC8\uC18D\uC5D0\uC11C \uB9CC\uB4E4\uC5B4\uBD10!"
      exitButton: 0
    - text: "\uD798\uB4E4 \uB550 \uC7A0\uC2DC \uC26C\uC5B4\uB3C4 \uC88B\uC544. \uC548\uC804\uD55C
        \uACF3\uC774 \uC788\uC73C\uBA74, \uB0B4\uC77C\uB3C4 \uB354 \uD798\uCC28\uAC8C
        \uB2EC\uB9B4 \uC218 \uC788\uC73C\uB2C8\uAE4C."
      exitButton: 1
  randomQuests:
  - name: "\uD1A0\uB07C \uB79C\uB364 \uD018\uC2A4\uD2B8 1"
    text: "\uD1A0\uB07C \uB79C\uB364 \uD018\uC2A4\uD2B8 1"
    uiText: "\uD1A0\uB07C \uB79C\uB364 \uD018\uC2A4\uD2B8 1"
    clearText: "\uD1A0\uB07C \uB79C\uB364 \uD018\uC2A4\uD2B8 \uD074\uB9AC\uC5B4 1"
    goal: 1
    reward: 1
  - name: "\uD1A0\uB07C \uB79C\uB364 \uD018\uC2A4\uD2B8 2"
    text: "\uD1A0\uB07C \uB79C\uB364 \uD018\uC2A4\uD2B8 2"
    uiText: "\uD1A0\uB07C \uB79C\uB364 \uD018\uC2A4\uD2B8 2"
    clearText: "\uD1A0\uB07C \uB79C\uB364 \uD018\uC2A4\uD2B8 \uD074\uB9AC\uC5B4 2"
    goal: 2
    reward: 2
  - name: "\uD1A0\uB07C \uB79C\uB364 \uD018\uC2A4\uD2B8 3"
    text: "\uD1A0\uB07C \uB79C\uB364 \uD018\uC2A4\uD2B8 3"
    uiText: "\uD1A0\uB07C \uB79C\uB364 \uD018\uC2A4\uD2B8 3"
    clearText: "\uD1A0\uB07C \uB79C\uB364 \uD018\uC2A4\uD2B8 \uD074\uB9AC\uC5B4 3"
    goal: 3
    reward: 3
  quests:
  - name: "\uBA54\uC778 \uD018\uC2A4\uD2B8"
    text: "\uBA54\uC778 \uD018\uC2A4\uD2B8 \uC2DC\uC791"
    uiText: "\uAE30\uC5B5 \uC870\uAC01\uC744 \uBAA8\uC544\uB77C"
    clearText: "\u2026\uC774\uC81C \uB108\uB294 \uBAA8\uB4E0 \uC870\uAC01\uC744 \uBAA8\uC558\uAD6C\uB098.
      \uB124\uAC00 \uB204\uAD6C\uC600\uB294\uC9C0, \uC65C \uC5EC\uAE30\uC5D0 \uAC07\uD614\uB294\uC9C0,
      \uC5B4\uB5BB\uAC8C \uB3CC\uC544\uAC08 \uC218 \uC788\uB294\uC9C0\uB3C4\u2026
      \uC774\uC81C \uBAA8\uB450 \uC54C\uAC8C \uB420 \uAC70\uC57C."
    goal: 3
    reward: 1
