%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 915396d3d934ae841b175b06346b2ce2, type: 3}
  m_Name: SnowFairyData
  m_EditorClassIdentifier: 
  text: "\u2026\uCDA5\uC9C0? \uADF8\uB798\uB3C4 \uC774\uC0C1\uD558\uAC8C \uB9C8\uC74C\uC740
    \uC870\uC6A9\uD574\uC9C0\uC9C0? \uC774 \uB208\uC740, \uB124\uAC00 \uC678\uB86D\uACE0
    \uC870\uC6A9\uD560 \uB54C\uB9C8\uB2E4 \uC313\uC778 \uAC70\uC57C. \uADF8\uB798\uC11C
    \uC774\uB807\uAC8C \uAE68\uB057\uD55C \uAC70\uC57C."
  npcDialog:
  - type: 3
    buttonName: "\uB79C\uB364 \uD018\uC2A4\uD2B8"
    npcDialogTexts:
    - text: "\uD018\uC2A4\uD2B8"
      exitButton: 1
  - type: 0
    buttonName: "\uB300\uD654\uD55C\uB2E4"
    npcDialogTexts:
    - text: "\uC5EC\uAE34 \uB108\uC758 \uC678\uB85C\uC6C0\uC774 \uC313\uC778 \uACF3\uC774\uC57C.
        \uD558\uC9C0\uB9CC, \uB0B4\uAC00 \uC788\uC796\uC544. \uB098 \uD63C\uC790\uB77C\uB3C4
        \uB110 \uB530\uB73B\uD558\uAC8C \uD574\uC904\uAC8C."
      exitButton: 1
    - text: "\uD604\uC2E4\uC740 \uCC28\uAC11\uACE0, \uB124\uAC00 \uACAC\uB514\uAE30\uC5D4
        \uB108\uBB34 \uD798\uB4E4\uC5C8\uC796\uC544. \uADF8\uCE58? \uC5EC\uAE34\u2026
        \uC544\uD504\uC9C0 \uC54A\uC796\uC544."
      exitButton: 1
  - type: 2
    buttonName: "\uC0AC\uB9C9 \uC9C0\uC5ED?"
    npcDialogTexts:
    - text: "\uC774\uACF3\uC758 \uBC24\uC5D0\uB294 \uC2A4\uB178\uC6B0\uB9E8\uACFC
        \uBC15\uC950\uAC00 \uB098\uD0C0\uB0A0\uAC70\uC57C... \uADF8\uAC83\uB4E4\uC5D0\uAC8C
        \uCD1B\uBD88\uC774 \uC7A0\uB4E4\uC5B4 \uC788\uC5B4. \uC544\uB9C8 \uB124\uAC00
        \uAC00\uC7A5 \uAC10\uCD94\uACE0 \uC2F6\uC740 \uAE30\uC5B5\uC744 \uD488\uC740
        \uACF3\uC774\uACA0\uC9C0."
      exitButton: 0
    - text: "\uCD1B\uBD88\uC774 \uC5C6\uC73C\uBA74 \uB2E4\uC74C \uBB38\uC740 \uC5F4\uB9AC\uC9C0
        \uC54A\uC544. \uADF8\uAC74\u2026 \uB124\uAC00 \uC120\uD0DD\uD574\uC57C \uD560
        \uC9C4\uC9DC \uB9C8\uC74C\uC774\uB2C8\uAE4C."
      exitButton: 0
    - text: "\uC232\uC5D0\uC11C \uD588\uB358\uAC83\uACFC \uB611\uAC19\uC544. \uCD1B\uBD88\uC744
        \uCC3E\uC544, \uADF8\uAC8C \uAE38\uC744 \uC54C\uB824\uC904\uAC70\uC57C."
      exitButton: 1
  - type: 1
    buttonName: "\uAC74\uCD95?"
    npcDialogTexts:
    - text: "\uC544\uB9B0, \uC5EC\uAE30\uC120 \uB124\uAC00 \uC6D0\uD558\uB294 \uB300\uB85C
        \uC9D1\uC744 \uB9CC\uB4E4 \uC218 \uC788\uC5B4! \uB208\uBC2D\uC5D0 \uB530\uB73B\uD55C
        \uC6B8\uD0C0\uB9AC\uB3C4 \uC138\uC6B0\uACE0, \uBD88\uBE5B\uB3C4 \uBC1D\uD600\uC11C
        \uBB34\uC11C\uC6B4 \uBC24\uC744 \uC774\uACA8\uB0B4\uC790."
      exitButton: 0
    - text: "\uB098\uBB34\uB791 \uB3CC, \uBC18\uC9DD\uC774\uB294 \uC5BC\uC74C \uC870\uAC01\uB3C4
        \uC4F8 \uC218 \uC788\uC5B4. \uB108\uB9CC\uC758 \uC548\uC804\uD55C \uBCF4\uAE08\uC790\uB9AC\uB97C
        \uAFC8\uC18D\uC5D0\uC11C \uB9CC\uB4E4\uC5B4\uBD10!"
      exitButton: 0
    - text: "\uD798\uB4E4 \uB550 \uC7A0\uC2DC \uC26C\uC5B4\uB3C4 \uC88B\uC544. \uC548\uC804\uD55C
        \uACF3\uC774 \uC788\uC73C\uBA74, \uB0B4\uC77C\uB3C4 \uB354 \uD798\uCC28\uAC8C
        \uB2EC\uB9B4 \uC218 \uC788\uC73C\uB2C8\uAE4C."
      exitButton: 1
  randomQuests:
  - name: Bat
    text: "\uC774\uACF3\uC758 \uBC15\uC950\uB294 \uCD08\uC74C\uD30C\uB85C \uB110
      \uAD34\uB86D\uD790\uAEBC\uC57C. \uC870\uAE08\uB9CC \uD63C\uB0B4\uC8FC\uC790."
    uiText: "\uBC15\uC950\uB97C \uC4F0\uB7EC\uD2B8\uB9AC\uC790"
    clearText: "\uC798\uD588\uC5B4! \uC544\uB9C8 \uBC15\uC950\uB4E4\uB3C4 \uC870\uAE08
      \uC58C\uC804\uD574\uC9C0\uACA0\uC9C0..."
    goal: 5
    reward: 1
  mainQuests:
    name: "\uBA54\uC778 \uD018\uC2A4\uD2B83"
    text: 
    uiText: "\uB2E4\uC74C \uC9C0\uC5ED\uC73C\uB85C \uAC00\uC790"
    clearText: 
    goal: 1
    reward: 1
